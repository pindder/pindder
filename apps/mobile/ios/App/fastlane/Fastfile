require 'json'

platform :ios do
  desc "Push a new beta build to Apple TestFlight"
  lane :beta do
    
    # 1. Authenticate with App Store Connect API Key
    app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_content: ENV["ASC_KEY_CONTENT"],
      is_key_content_base64: true
    )

    # 2. Find monorepo root for package.json version
    workspace_root = Dir.pwd
    until File.exist?(File.join(workspace_root, 'nx.json')) || workspace_root == '/'
      workspace_root = File.dirname(workspace_root)
    end
    
    package_json_path = File.join(workspace_root, 'package.json')
    package_data = JSON.parse(File.read(package_json_path))
    package_version = package_data["version"]
    
    UI.message("Syncing iOS marketing version: #{package_version}")

    # 3. Apply marketing version
    increment_version_number(
      version_number: package_version,
      xcodeproj: "App.xcodeproj"
    )

    # 4. Fetch latest build number and increment
    latest_build = latest_testflight_build_number(
      app_identifier: "com.pindder.app",
      initial_build_number: 1
    )
    new_build_number = latest_build + 1
    
    increment_build_number(
      build_number: new_build_number.to_s,
      xcodeproj: "App.xcodeproj"
    )

    # 5. Use Fastlane Match for secure, automated CI code signing
    match(
      type: "appstore",
      app_identifier: "com.pindder.app",
      readonly: true, # Set to false only when first generating/uploading certs from your local machine
      git_url: "https://github.com/pindder/pindder.git"
    )

    # 6. Build the iOS App (.ipa)
    build_app(
      workspace: "App.xcworkspace",
      scheme: "App",
      export_method: "app-store",
      xcargs: "-allowProvisioningUpdates",
      export_xcargs: "-allowProvisioningUpdates"
    )

    # 9. Upload to TestFlight
    upload_to_testflight(
      skip_waiting_for_build_processing: true
    )
  end
end