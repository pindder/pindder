platform :ios do
  desc "Push a new beta build to Apple TestFlight"
  lane :beta do
    
    # 1. Authenticate with App Store Connect API Key
    app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_content: ENV["ASC_KEY_CONTENT"],
      is_key_content_base64: true
    )

    # 2. Dynamically find monorepo root and sync versions (if using package.json)
    # ... your version logic ...

    # 3. Fetch latest build number and increment
    latest_build = latest_testflight_build_number(
      app_identifier: "com.pindder.app",
      initial_build_number: 1
    )
    new_build_number = latest_build + 1
    
    increment_build_number(
      build_number: new_build_number.to_s,
      xcodeproj: "apps/mobile/ios/App/App.xcodeproj"
    )

    # 4. Automatically download or generate the provisioning profile via API Key
    get_provisioning_profile(
      app_identifier: "com.pindder.app",
      adhoc: false # false creates an App Store profile
    )

    # 5. Build the iOS App (.ipa) with provisioning updates allowed
    build_app(
      workspace: "apps/mobile/ios/App/App.xcworkspace",
      scheme: "App",
      export_method: "app-store",
      xcargs: "-allowProvisioningUpdates",
      export_xcargs: "-allowProvisioningUpdates"
    )

    # 6. Upload to TestFlight
    upload_to_testflight(
      skip_waiting_for_build_processing: true
    )
  end
end