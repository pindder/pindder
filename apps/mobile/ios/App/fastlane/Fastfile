default_platform(:ios)

platform :ios do
  desc "Push a new beta build to Apple TestFlight"
  lane :beta do
    
    # 1. Authenticate with App Store Connect API Key
    app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_content: ENV["ASC_KEY_CONTENT"],
      is_key_content_base64: true
    )

    # 2. Fetch the highest build number currently on TestFlight and increment it
    # Replace "com.pindder.app" with your exact bundle identifier
    latest_build = latest_testflight_build_number(
      app_identifier: "com.pindder.app",
      initial_build_number: 1 # Fallback if this is the very first build ever
    )
    new_build_number = latest_build + 1
    UI.message("Latest TestFlight build was #{latest_build}. Incrementing to #{new_build_number}...")

    increment_build_number(
      build_number: new_build_number.to_s,
      xcodeproj: "App.xcodeproj"
    )

    # 3. Automatically apply team settings and project configurations for CI
    update_code_signing_settings(
      use_automatic_signing: true,
      team_id: ENV["ASC_TEAM_ID"],
      path: "App.xcodeproj"
    )

    # 4. Build the iOS App (.ipa) with provisioning updates allowed
    build_app(
      workspace: "App.xcworkspace",
      scheme: "App",
      export_method: "app-store",
      xcargs: "-allowProvisioningUpdates",
      export_xcargs: "-allowProvisioningUpdates"
    )

    # 5. Upload to TestFlight
    upload_to_testflight(
      skip_waiting_for_build_processing: true
    )
  end
end