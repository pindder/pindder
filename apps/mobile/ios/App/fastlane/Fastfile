default_platform(:ios)

platform :ios do
  desc "Push a new beta build to Apple TestFlight"
  lane :beta do
    
    # 1. Authenticate with App Store Connect API Key
    app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_content: ENV["ASC_KEY_CONTENT"],
      is_key_content_base64: true
    )

    # 2. Automatically apply team settings and project configurations for CI
    # Replace "YOUR_TEAM_ID" with your 10-character Apple Developer Team ID (e.g. "ABC123XYZ")
    update_code_signing_settings(
      use_automatic_signing: true,
      team_id: ENV["ASC_TEAM_ID"],
      path: "App.xcodeproj"
    )

    # 3. Build the iOS App (.ipa)
    build_app(
      workspace: "App.xcworkspace",
      scheme: "App",
      export_method: "app-store"
    )

    # 4. Upload to TestFlight
    upload_to_testflight(
      skip_waiting_for_build_processing: true
    )
  end
end