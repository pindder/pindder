default_platform(:android)

platform :android do
  desc "Deploy a new release to Google Play Internal Testing"
  lane :beta do
    
    # 1. Setup keystore environment variables for signing
    # (Values are pulled securely from GitHub Secrets)
    
    # 2. Build the signed App Bundle (AAB) using Gradle
    gradle(
      task: "bundle",
      build_type: "Release",
      properties: {
        "android.injected.signing.store.file" => ENV["KEYSTORE_PATH"],
        "android.injected.signing.store.password" => ENV["KEYSTORE_PASSWORD"],
        "android.injected.signing.key.alias" => ENV["KEY_ALIAS"],
        "android.injected.signing.key.password" => ENV["KEY_PASSWORD"],
      }
    )

    # 3. Upload to Google Play Console
    upload_to_play_store(
      track: 'internal',                  # Change to 'production' when ready for public release
      skip_upload_screenshots: true,
      skip_upload_images: true
    )
  end
end